# Website live feed (required for WhatsApp → site sync)
FEED_API_SECRET=generate-a-long-random-secret

# Upstash Redis (auto-set when Upstash integration is linked on Vercel)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Web Push notifications ---
# Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Optional send secret (defaults to FEED_API_SECRET):
# PUSH_SEND_SECRET=

# Public site URL for bot configuration / map deep links:
# WEBSITE_URL=https://your-project.vercel.app
# WEBSITE_FEED_URL=https://your-project.vercel.app/api/feed

# WhatsApp group for rocket / חמ״ל alerts (invite link)
ROCKETS_WHATSAPP_INVITE_LINK=https://chat.whatsapp.com/DgafURRfpIqD2mLd3xLwf5
# ROCKETS_WHATSAPP_GROUP_NAME=חמ״ל התרעות איראן
# After the bot joins the group, set the WhatsApp chat id:
# MISSILE_WHATSAPP_CHAT_ID=120363...@g.us

# --- Telegram alerts + interactive menu ---
# 1) Create bot: https://t.me/BotFather → /newbot
# 2) Add bot to your group/channel (admin if channel)
# 3) Set:
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALERT_CHAT_ID=-100xxxxxxxxxx
# FEED_API_SECRET=same-secret-used-for-notify-auth
# Optional: TELEGRAM_NOTIFY_SECRET=...
# Optional webhook secret (must match setup):
# TELEGRAM_WEBHOOK_SECRET=long-random-string
# 4) Register menu webhook (once after deploy):
#    POST /api/rockets/telegram-setup  Authorization: Bearer <secret>
#    Body optional: { "url": "https://your-app.vercel.app/api/rockets/telegram-webhook" }
# 5) Open the bot in Telegram → /start → menu
# Test: POST /api/rockets/telegram-test with Authorization: Bearer <secret>
# Auto: GET/POST /api/rockets/notify (Vercel Hobby cron = once daily;
# for live alerts use Pro cron */2 * * * * or an external uptime ping every 1–2 min)
# Alerts include area + shelter time + /rockets?area=… map link
# Subscribers who picked areas via the bot menu also get filtered DMs

# Personal AI chat (private — /chat, not linked in nav)
CHAT_PASSWORD=david2026
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- WhatsApp flight-search bot (conversational: "טיסה" → asks from/to/dates) ---
# Runs via a separate, always-on connector — see scripts/whatsapp-flights-bot/README.md
# FLIGHTS_BOT_SECRET=generate-a-long-random-secret (same value in the connector's .env)

# --- Amadeus (optional — real flight/hotel prices, free Self-Service tier) ---
# 1) Sign up: https://developers.amadeus.com/register (free, no payment info)
# 2) Create an app in "My Self-Service Workspace" → copy API Key + API Secret
#    (the free "test" environment is used automatically — see lib/amadeus/constants.ts)
# Without these, /hotels and the flight-search bot still work fine — they just
# show only the Google Flights / Skyscanner / Booking.com search links, no inline prices.
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=

