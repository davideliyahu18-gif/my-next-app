# Website live feed (required for WhatsApp → site sync)
FEED_API_SECRET=generate-a-long-random-secret

# Upstash Redis (auto-set when Upstash integration is linked on Vercel)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Public site URL for bot configuration:
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# WEBSITE_FEED_URL=https://your-project.vercel.app/api/feed

# Cron / bot API secrets (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-secret
MISSILE_ALERT_SECRET=generate-a-long-random-secret

# --- Iran → Kuwait missile WhatsApp alerts (text + location pin) ---
# Corridor default is Kuwait. Set to "israel" to keep Israel as map default.
MISSILE_ALERT_CORRIDOR=kuwait
# MISSILE_ALERT_REQUIRE_KUWAIT_MENTION=false
# MISSILE_ALERT_SEND_LAUNCH_PIN=true
# MISSILE_ALERT_POLL_CRON=*/1 * * * *

# Green API (serverless WhatsApp send — text + sendLocation)
# GREEN_API_INSTANCE=
# GREEN_API_TOKEN=
# MISSILE_WHATSAPP_CHAT_ID=120363...@g.us
# WHATSAPP_GROUP_CHAT_ID=

# Local Baileys script: scripts/missile-whatsapp
# MISSILE_ALERT_SITE_URL=http://127.0.0.1:3000
# MISSILE_WHATSAPP_GROUP_NAME=התראות שיגורים כווית

# Optional Telegram mirror
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Personal AI chat (private — /chat, not linked in nav)
CHAT_PASSWORD=david2026
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
