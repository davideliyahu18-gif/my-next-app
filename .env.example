# --- Multi-league football WhatsApp bot ---
# Site API the Baileys bot calls for commands + alerts:
FOOTBALL_BOT_SITE_URL=http://127.0.0.1:3000
FOOTBALL_BOT_SECRET=generate-a-long-random-secret
# FOOTBALL_BOT_ALERTS=true
# FOOTBALL_BOT_POLL_CRON=*/1 * * * *
# FOOTBALL_BOT_REMINDER_MINUTES=30
# Daily morning status to the WhatsApp group (Israel time):
# FOOTBALL_BOT_MORNING=true
# FOOTBALL_BOT_MORNING_CRON=0 8 * * *
# FOOTBALL_BOT_MORNING_TZ=Asia/Jerusalem
# FOOTBALL_BOT_BUTTONS=true
# Allow the linked WhatsApp phone to type commands in the group (fromMe).
# FOOTBALL_BOT_ALLOW_FROM_ME=true
# Operator numbers that may command when linked / for allowlist (comma-separated).
FOOTBALL_BOT_OPERATORS=0523123944
# FOOTBALL_BOT_OPERATORS_ONLY=false

# WhatsApp group (name match OR chat id after first connect)
FOOTBALL_WHATSAPP_GROUP_NAME=דוד | עדכוני כדורגל
# FOOTBALL_WHATSAPP_CHAT_ID=120363...@g.us

