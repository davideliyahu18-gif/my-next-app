# Full URL of the search-bot endpoint on your deployed site
WEBHOOK_URL=https://your-app.vercel.app/api/flights/search-bot

# Same value as FLIGHTS_BOT_SECRET set on the Vercel project
FLIGHTS_BOT_SECRET=change-me-to-a-long-random-string

# WhatsApp group JID to listen to, e.g. 123456789012345678@g.us
# Leave empty on first run — the console will print the JID of any chat
# that messages the bot, so you can copy it from there.
GROUP_JID=
